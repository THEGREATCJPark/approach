{
  "prerequisite-ready": {
    "fixture": [
      {
        "id": "intro",
        "requires": []
      },
      {
        "id": "measure",
        "requires": [
          "intro"
        ]
      },
      {
        "id": "cut",
        "requires": [
          "measure"
        ]
      },
      {
        "id": "join",
        "requires": [
          "intro"
        ]
      },
      {
        "id": "finish",
        "requires": [
          "cut",
          "join"
        ]
      }
    ],
    "tests": [
      {
        "kind": "정상",
        "input": {
          "done": [
            "intro"
          ]
        },
        "expected": [
          "join",
          "measure"
        ],
        "basis": "두 개의 직접 선수가 모두 intro이다."
      },
      {
        "kind": "경계",
        "input": {
          "done": [
            "intro",
            "measure",
            "cut",
            "join",
            "finish"
          ]
        },
        "expected": [],
        "basis": "전부 완료이면 추천할 미완료가 없다."
      },
      {
        "kind": "정보 부족",
        "input": {
          "done": null
        },
        "expected": "unknown",
        "basis": "미기록은 미이수와 다르다."
      },
      {
        "kind": "충돌",
        "input": {
          "done": [],
          "cycle": true
        },
        "expected": "invalid_cycle",
        "basis": "intro가 finish를 선수로 요구하면 순환이다."
      },
      {
        "kind": "순서변경",
        "input": {
          "done": [
            "intro"
          ],
          "reverse": true
        },
        "expected": [
          "join",
          "measure"
        ],
        "basis": "행 순서는 의존 관계를 바꾸지 않는다."
      },
      {
        "kind": "새 표본",
        "input": {
          "done": [
            "intro",
            "measure",
            "join"
          ]
        },
        "expected": [
          "cut"
        ],
        "basis": "finish는 아직 cut이 필요하다."
      }
    ]
  },
